# Project Harmony — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# Never commit .env files to version control.

# =============================================================================
# Google Cloud Platform
# =============================================================================
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/gcp-service-account.json

# BigQuery Configuration
BIGQUERY_DATASET=project_harmony
BIGQUERY_LOCATION=US

# GCS Configuration
HARMONY_DRONE_BUCKET=harmony-drone-telemetry

# =============================================================================
# Sentinel Hub (Satellite Imagery)
# =============================================================================
SENTINEL_CLIENT_ID=your-sentinel-hub-client-id
SENTINEL_CLIENT_SECRET=your-sentinel-hub-client-secret

# =============================================================================
# Sensor Gateway API
# =============================================================================
SENSOR_API_KEY=your-sensor-gateway-api-key

# =============================================================================
# MQTT Broker (IoT Telemetry)
# =============================================================================
MQTT_BROKER_HOST=your-mqtt-broker.example.com
MQTT_BROKER_PORT=8883
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password
MQTT_USE_TLS=true

# =============================================================================
# Edge Cache
# =============================================================================
EDGE_CACHE_DB_PATH=/var/lib/harmony/edge_cache.db
EDGE_CACHE_MAX_SIZE_MB=500
EDGE_FLUSH_INTERVAL_SEC=300

# =============================================================================
# Pipeline Configuration
# =============================================================================
PIPELINE_LOG_LEVEL=INFO
PIPELINE_ENVIRONMENT=production

# =============================================================================
# Hot Crop Compliance (Hemp Regulation Thresholds)
# =============================================================================
HEMP_PH_MIN=6.0
HEMP_PH_MAX=7.5
HEMP_MAX_NITROGEN_MG_KG=200
COMPLIANCE_ALERT_WEBHOOK=https://your-alerts.example.com/webhook
